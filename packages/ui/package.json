{
  "name": "@lucas/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/ui.css",
    "./tokens": "./dist/tokens/tokens.css",
    "./tokens-dark": "./dist/tokens/tokens-dark.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests --coverage",
    "test:coverage": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.3.1",
    "tsx": "^4.21.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@fontsource-variable/inter": "^5.2.8",
    "clsx": "^2.1.1",
    "focus-trap-react": "^12.0.0",
    "lucide-react": "^0.577.0",
    "react-hook-form": "^7.72.0"
  }
}
